# docker-compose.override.yml 템플릿. 실제로 쓰려면 이 파일을 복사해서
# docker-compose.override.yml로 이름을 바꾸고, .env.example도 .env로 복사해서
# 실제 키 값을 채운다 — 두 파일 다 .gitignore에 있어서 git엔 안 올라간다.
#
# docker compose는 docker-compose.yml + docker-compose.override.yml을
# 자동으로 합쳐서 읽는다(-f 옵션 필요 없음). ${VAR}는 같은 폴더의 .env에서
# 값을 채워 넣는다 — 이 파일 자체엔 실제 키 값이 없어서 커밋해도 안전하다.
services:
  stt-pipe:
    environment:
      OLLAMA_API_KEY: ${OLLAMA_API_KEY}
      OPENAI_API_KEY: ${OPENAI_API_KEY}
